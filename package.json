{
  "name": "shipyard-pocketbase-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Template repository for Shipyard + PocketBase applications",
  "scripts": {
    "dockerWithPorts": "docker compose run --rm -e POCKETBASE_URL=http://pocketbase-dev:8090 -p 4321:4321 runner",
    "docker": "docker compose run -e POCKETBASE_URL=http://pocketbase-dev:8090 runner",
    "dev:bare": "astro dev --host",
    "dev": "npm run dockerWithPorts npm run dev:bare",
    "start": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "docker:test": "docker compose run --rm playwright",
    "test:playwright:bare": "npx playwright test",
    "test:playwright": "npm run docker:test npm run test:playwright:bare",
    "test:bare": "vitest",
    "test": "npm run docker:test npm run test:bare",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^11.1.9",
    "@levino/pocketbase-auth": "*",
    "@levino/shipyard-base": "^0.9.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "daisyui": "^5.7.50",
    "pocketbase": "^0.26.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.0.16",
    "baseline-browser-mapping": "^2.11.30",
    "typescript": "^5.8.2",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
